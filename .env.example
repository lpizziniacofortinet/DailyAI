# ==============================================================================
# DailyAI Configuration Template
# Autonomous Agentic Intelligence & Fact-Checking Pipeline for AI, Cyber & V2X
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers: "gemini", "openai", "mock"
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Used when LLM_PROVIDER=gemini (Default recommended provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Optional alternative provider)
# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. Web Search & Intelligence Gathering Configuration
# ------------------------------------------------------------------------------
# Primary search provider: "duckduckgo", "tavily", "serper", "rss_only", "mock"
SEARCH_PROVIDER=duckduckgo

# Optional API Keys for premium search providers
TAVILY_API_KEY=
SERPER_API_KEY=

# Maximum search queries to run per domain category (AI, Cybersecurity, V2X)
SEARCH_QUERIES_PER_CATEGORY=4

# Maximum search results to inspect per query
MAX_SEARCH_RESULTS_PER_QUERY=5

# Maximum look-back period in hours for articles (e.g., 24, 48, 72)
LOOKBACK_HOURS=24

# Enable/disable high-authority curated RSS feeds in Agent 1
ENABLE_RSS_FEEDS=true

# ------------------------------------------------------------------------------
# 3. Agent 2 (Fact-Checking & Quality Gate) Configuration
# ------------------------------------------------------------------------------
# Strict verification mode ensures unsupported claims are rejected or flagged
FACT_CHECK_STRICT_MODE=true

# Minimum quality & confidence score (0.0 to 1.0) required for publication
MIN_CONFIDENCE_SCORE=0.75

# Maximum articles to publish per domain category in the final newsletter
MAX_ARTICLES_PER_CATEGORY=4

# ------------------------------------------------------------------------------
# 4. Email Delivery & SMTP Configuration (Agent 3)
# ------------------------------------------------------------------------------
# Enable or disable actual email dispatch (when false, newsletter is saved to disk only)
EMAIL_ENABLED=false

# SMTP Server Connection Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMTP Authentication Credentials
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Email Sender and Recipients (Comma-separated list for multiple recipients)
EMAIL_FROM="DailyAI Intelligence <noreply@dailyai.local>"
EMAIL_RECIPIENTS=subscriber1@example.com,subscriber2@example.com
EMAIL_SUBJECT_PREFIX=[DailyAI Intelligence]

# Directory where generated newsletters are archived (HTML and Markdown)
OUTPUT_DIR=output/newsletters

# ------------------------------------------------------------------------------
# 5. Persistent Storage & Deduplication
# ------------------------------------------------------------------------------
# SQLite database path for persistent URL deduplication & execution logs
DATABASE_PATH=data/dailyai.sqlite

# ------------------------------------------------------------------------------
# 6. Pipeline Execution & Scheduling
# ------------------------------------------------------------------------------
# Schedule mode: "cron" or "interval" (used with `dailyai schedule`)
# Examples:
#   Cron format: "0 8 * * *" (Every day at 08:00 AM)
#   Interval format (minutes): "1440" (Every 24 hours)
SCHEDULE_CRON="0 8 * * *"
SCHEDULE_INTERVAL_MINUTES=1440

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
